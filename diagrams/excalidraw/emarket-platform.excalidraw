    {
      "id": "MWFw-w6_lx-5KEkL1k0zM",
      "type": "text",
      "x": -443.76115322113037,
      "y": -516.8634913353903,
      "width": 528.9781494140625,
      "height": 210,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
